    Hybrid Cooler 2,                    !- Equipment 2 Name
    FluidCooler:TwoSpeed,               !- Equipment 3 Object Type
    Hybrid Cooler 3;                    !- Equipment 3 Name
! Hard-sized per cooler (EnergyPlus 22.2 autosizes High Fan Speed Air Flow Rate as
! Q/(EWT-EAT)*4 'm3/s', ~1000x too large, and fan power as 0.0105 W/W):
!   nominal capacity = chiller design capacity 552 kW x (1 + 1/COP_ref 5.38)
!   water flow = Q/(rho cp range), air flow = Q/(rho_air cp_air 10 K), fan = 0.02 W/W x Q
!   low speed: air 0.5 x high, fan 0.16 x high, capacity chosen so that E+ sizes
!   UA_low = 0.6 x UA_high
! Design air state = pad-cooled 0.4% DB=>MWB condition (set_design_days.py updates it per site).
! The next line is read by set_design_days.py; keep it directly above each cooler.
! hybrid-design: approach=5.6 range=5.6 air_dT=10 low_UA_frac=0.6 pad_eff=0.85
  FluidCooler:TwoSpeed,
    Hybrid Cooler 1,                    !- Name
    Hybrid Cooler 1 Water Inlet,        !- Water Inlet Node Name
    Hybrid Cooler 1 Water Outlet,       !- Water Outlet Node Name
    NominalCapacity,                    !- Performance Input Method
    ,                                   !- High Fan Speed U-factor Times Area Value
    ,                                   !- Low Fan Speed U-factor Times Area Value
    ,                                   !- Low Fan Speed U-Factor Times Area Sizing Factor
    654602,                             !- High Speed Nominal Capacity
    357454,                             !- Low Speed Nominal Capacity
    ,                                   !- Low Speed Nominal Capacity Sizing Factor
    35.48,                              !- Design Entering Water Temperature
    24.28,                              !- Design Entering Air Temperature
    20.80,                              !- Design Entering Air Wet-bulb Temperature
    0.02797,                            !- Design Water Flow Rate
    56.933,                             !- High Fan Speed Air Flow Rate
    13092,                              !- High Fan Speed Fan Power
    28.466,                             !- Low Fan Speed Air Flow Rate
    ,                                   !- Low Fan Speed Air Flow Rate Sizing Factor
    2095,                               !- Low Fan Speed Fan Power
    ,                                   !- Low Fan Speed Fan Power Sizing Factor
    Hybrid Cooler Air Inlet;            !- Outdoor Air Inlet Node Name
! hybrid-design: approach=5.6 range=5.6 air_dT=10 low_UA_frac=0.6 pad_eff=0.85
  FluidCooler:TwoSpeed,
