!==============================================================================
! IT equipment (ElectricEquipment:ITE:AirCooled) and lighting
!==============================================================================

! P_cpu/P_cpu,design = 0.30 + 0.70*u  (idle = 30% of peak; assumption)
  Curve:Biquadratic,
    ITE CPU Power fLoadTemp,            !- Name
    0.30,                               !- Coefficient1 Constant
    0.70,                               !- Coefficient2 x
    0,                                  !- Coefficient3 x**2
    0,                                  !- Coefficient4 y
    0,                                  !- Coefficient5 y**2
    0,                                  !- Coefficient6 x*y
    0,                                  !- Minimum Value of x
    1.0,                                !- Maximum Value of x
    -10,                                !- Minimum Value of y
    99,                                 !- Maximum Value of y
    0.0,                                !- Minimum Curve Output
    1.0,                                !- Maximum Curve Output
    Dimensionless,                      !- Input Unit Type for X
    Temperature,                        !- Input Unit Type for Y
    Dimensionless;                      !- Output Unit Type

! Server airflow fraction = 0.60 + 0.40*u (assumption)
  Curve:Biquadratic,
    ITE Airflow fLoadTemp,              !- Name
    0.60,                               !- Coefficient1 Constant
    0.40,                               !- Coefficient2 x
    0,                                  !- Coefficient3 x**2
    0,                                  !- Coefficient4 y
    0,                                  !- Coefficient5 y**2
    0,                                  !- Coefficient6 x*y
    0,                                  !- Minimum Value of x
    1.0,                                !- Maximum Value of x
    -10,                                !- Minimum Value of y
    99,                                 !- Maximum Value of y
    0.0,                                !- Minimum Curve Output
    1.0,                                !- Maximum Curve Output
    Dimensionless,                      !- Input Unit Type for X
    Temperature,                        !- Input Unit Type for Y
    Dimensionless;                      !- Output Unit Type

! Server fan affinity law (cube)
  Curve:Cubic,
    ITE Fan Power fFlow,                !- Name
    0,                                  !- Coefficient1 Constant
    0,                                  !- Coefficient2 x
    0,                                  !- Coefficient3 x**2
    1.0,                                !- Coefficient4 x**3
    0,                                  !- Minimum Value of x
    1.5;                                !- Maximum Value of x

  Curve:Biquadratic,
    ITE Recirc fLoadTemp,               !- Name
    1.0,                                !- Coefficient1 Constant
    0,                                  !- Coefficient2 x
    0,                                  !- Coefficient3 x**2
    0,                                  !- Coefficient4 y
    0,                                  !- Coefficient5 y**2
    0,                                  !- Coefficient6 x*y
    0,                                  !- Minimum Value of x
    1.5,                                !- Maximum Value of x
    -10,                                !- Minimum Value of y
    99,                                 !- Maximum Value of y
    0.0,                                !- Minimum Curve Output
    1.0,                                !- Maximum Curve Output
    Dimensionless,                      !- Input Unit Type for X
    Temperature,                        !- Input Unit Type for Y
    Dimensionless;                      !- Output Unit Type

! Flat UPS efficiency over the 0.75-1.0 load range seen here (assumption)
  Curve:Quadratic,
    UPS Efficiency fPLR,                !- Name
    1.0,                                !- Coefficient1 Constant
    0,                                  !- Coefficient2 x
    0,                                  !- Coefficient3 x**2
    0,                                  !- Minimum Value of x
    1.5;                                !- Maximum Value of x

