! Design Loop Exit Temperature = cooler design entering (pad-cooled) air + approach (set by set_design_days.py)
  Sizing:Plant,
    CW Loop,                            !- Plant or Condenser Loop Name
    Condenser,                          !- Loop Type
    29.88,                              !- Design Loop Exit Temperature
    5.6;                                !- Loop Design Temperature Difference

! Shared air inlet of all hybrid coolers. A plugin/EMS program overrides its dry-bulb and wet-bulb
! (actuators 'Outdoor Air System Node' / 'Drybulb Temperature', 'Wetbulb Temperature') to model
! wetted-pad pre-cooling. Without that the node carries the site outdoor air state (dry operation).
  OutdoorAir:Node,
    Hybrid Cooler Air Inlet;            !- Name

! CW supply setpoint = cooler inlet air dry-bulb + design approach, limited to the chiller's range
  SetpointManager:FollowSystemNodeTemperature,
    Hybrid Condenser Setpoint,          !- Name
    Temperature,                        !- Control Variable
    Hybrid Cooler Air Inlet,            !- Reference Node Name
    NodeDryBulb,                        !- Reference Temperature Type
    5.6,                                !- Offset Temperature Difference
    40.0,                               !- Maximum Limit Setpoint Temperature
    23.0,                               !- Minimum Limit Setpoint Temperature
    CW Supply Outlet Node;              !- Setpoint Node or NodeList Name

