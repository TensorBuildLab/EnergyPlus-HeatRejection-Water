! =============================================================================

! datacenter_chiller_hybrid.idf  (EnergyPlus 22.2)

! Representative ~1 MW-IT data center: 2 data halls, CRAH (CHW coil + VAV fan),

! 3 x 50% water-cooled high-lift centrifugal chillers (N+1), variable-primary CHW at 10 C,

! 3 x FluidCooler:TwoSpeed hybrid adiabatic dry coolers (N+1) on one OutdoorAir:Node

! 'Hybrid Cooler Air Inlet', condenser water dry-bulb reset 'Hybrid Condenser Setpoint'.

! Without an EMS/plugin override of that node this is a plain DRY-cooler plant.

! GENERATED by models/build_datacenter_idf.py -- edit the generator, not this file.

! Design basis and sources: models/DATACENTER_MODEL.md

! =============================================================================


!==============================================================================
! Simulation control
!==============================================================================

  Version,
    22.2;                               !- Version Identifier

  SimulationControl,
    Yes,                                !- Do Zone Sizing Calculation
    Yes,                                !- Do System Sizing Calculation
    Yes,                                !- Do Plant Sizing Calculation
    No,                                 !- Run Simulation for Sizing Periods
    Yes,                                !- Run Simulation for Weather File Run Periods
    No,                                 !- Do HVAC Sizing Simulation for Sizing Periods
    1;                                  !- Maximum Number of HVAC Sizing Simulation Passes

  Building,
    Representative Water-Cooled Data Center 1MW IT,!- Name
    0,                                  !- North Axis
    City,                               !- Terrain
    0.04,                               !- Loads Convergence Tolerance Value
    0.2,                                !- Temperature Convergence Tolerance Value
    MinimalShadowing,                   !- Solar Distribution
    25,                                 !- Maximum Number of Warmup Days
    6;                                  !- Minimum Number of Warmup Days

  Timestep,
    6;                                  !- Number of Timesteps per Hour

  ConvergenceLimits,
    1,                                  !- Minimum System Timestep
    20,                                 !- Maximum HVAC Iterations
    2,                                  !- Minimum Plant Iterations
    8;                                  !- Maximum Plant Iterations

  RunPeriod,
    Annual,                             !- Name
    1,                                  !- Begin Month
    1,                                  !- Begin Day of Month
    ,                                   !- Begin Year
    12,                                 !- End Month
    31,                                 !- End Day of Month
    ,                                   !- End Year
    ,                                   !- Day of Week for Start Day
    Yes,                                !- Use Weather File Holidays and Special Days
    Yes,                                !- Use Weather File Daylight Saving Period
    No,                                 !- Apply Weekend Holiday Rule
    Yes,                                !- Use Weather File Rain Indicators
    Yes;                                !- Use Weather File Snow Indicators

  GlobalGeometryRules,
    UpperLeftCorner,                    !- Starting Vertex Position
    Counterclockwise,                   !- Vertex Entry Direction
    Relative;                           !- Coordinate System

  Sizing:Parameters,
    1.0,                                !- Heating Sizing Factor
    1.0,                                !- Cooling Sizing Factor
    6;                                  !- Timesteps in Averaging Window


